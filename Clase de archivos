#ESCRITURA 

nombres_columnas = ["nombre", "edad","ciudad"]
matriz = [["pedro",24,"París"],["Jose",25,"toronto"]]

def escritura_en_csv(nombre_archivo, nombres_columnas, matriz ):
    with open(nombre_archivo,"w")as archivo:
        archivo.write(",".join(nombres_columnas)+ "\n")

        for fila in matriz:
            linea = ""
            for i in range(len(fila)):

                linea += str(fila[i])

                if i < (len(fila) -1):
                    linea += ","
            archivo.write(linea + "\n")



